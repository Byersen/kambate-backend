generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------
enum EventStatus {
  SCHEDULED
  LIVE
  FINISHED
  CANCELED
  ARCHIVED
}

// -----------------------------------------------------------------------------
// CORE MODELS (Feed Unificado)
// -----------------------------------------------------------------------------
model Sport {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  
  leagues   League[]
  events    Event[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model League {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  country     String?
  logoUrl     String?
  tier        Int      @default(1) // 1: Top/Premium, 2: Secundario, 0: Ignorado
  isActive    Boolean  @default(true) // Control para descartar ligas no deseadas

  sportId     String
  sport       Sport    @relation(fields: [sportId], references: [id], onDelete: Cascade)

  events      Event[]
  favoritedBy UserFavoriteLeague[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sportId, isActive])
  @@index([tier])
}

model Season {
  id          String    @id @default(uuid())
  name        String    // ej. "2024-2025"
  slug        String    @unique // ej. "2024-2025"
  isCurrent   Boolean   @default(true)
  startDate   DateTime?
  endDate     DateTime?

  events      Event[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Event {
  id            String         @id @default(uuid())
  externalId    String?        @unique
  
  sportId       String
  sport         Sport          @relation(fields: [sportId], references: [id])

  leagueId      String?
  league        League?        @relation(fields: [leagueId], references: [id], onDelete: SetNull)

  seasonId      String?
  season        Season?        @relation(fields: [seasonId], references: [id], onDelete: SetNull)

  startDate     DateTime    
  status        EventStatus    @default(SCHEDULED)
  score         String?     

  participants  Participant[]
  
  footballStats FootballStats?
  nbaStats      NbaStats?
  ufcStats      UfcStats?
  esportsStats  EsportsStats?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, startDate])
  @@index([leagueId])
  @@index([seasonId])
}

model Participant {
  id          String         @id @default(uuid())
  externalId  String?
  name        String
  logoUrl     String?
  
  events      Event[]  
  favoritedBy UserFavorite[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

// -----------------------------------------------------------------------------
// STATS MODELS
// -----------------------------------------------------------------------------
model FootballStats {
  id             String  @id @default(uuid())
  eventId        String  @unique
  event          Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  homeGoals      Int?
  awayGoals      Int?
  homeCards      Int?
  awayCards      Int?
  extraStats     Json?
}

model NbaStats {
  id             String  @id @default(uuid())
  eventId        String  @unique
  event          Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  homePoints     Int?
  awayPoints     Int?
  quarter        Int?
}

model UfcStats {
  id             String  @id @default(uuid())
  eventId        String  @unique
  event          Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  method         String?
  round          Int?
  time           String?
}

model EsportsStats {
  id             String  @id @default(uuid())
  eventId        String  @unique
  event          Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  homeScore      Int?
  awayScore      Int?
  map            String?
}

// -----------------------------------------------------------------------------
// AUDIT & LOGS
// -----------------------------------------------------------------------------
model ScraperLog {
  id         String   @id @default(uuid())
  sport      String
  success    Boolean  @default(true)
  message    String?
  itemsCount Int?     @default(0)
  createdAt  DateTime @default(now())
}

// -----------------------------------------------------------------------------
// USERS, PREFERENCES & FAVORITES
// -----------------------------------------------------------------------------
model User {
  id               String               @id @default(uuid())
  email            String               @unique
  passwordHash     String
  name             String?
  
  preferences      UserPreference?
  favoriteTeams    UserFavorite[]
  favoriteLeagues  UserFavoriteLeague[]

  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model UserPreference {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  selectedSports  String[] @default([]) // ej. ["football", "nba"]
  onboardingDone  Boolean  @default(false)
  notifyLive      Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model UserFavorite {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  createdAt     DateTime    @default(now())

  @@unique([userId, participantId]) 
}

model UserFavoriteLeague {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  leagueId  String
  league    League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, leagueId])
}
