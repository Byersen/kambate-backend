generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------
enum EventStatus {
  SCHEDULED
  LIVE
  FINISHED
  CANCELED
}

// -----------------------------------------------------------------------------
// CORE MODELS (Feed Unificado)
// -----------------------------------------------------------------------------
model Sport {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  
  events    Event[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id          String      @id @default(uuid())
  externalId  String?     @unique
  sportId     String
  sport       Sport       @relation(fields: [sportId], references: [id])
  startDate   DateTime    
  status      EventStatus @default(SCHEDULED)
  score       String?     

  participants Participant[]
  
  footballStats FootballStats?
  nbaStats      NbaStats?
  ufcStats      UfcStats?
  esportsStats  EsportsStats?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Participant {
  id          String   @id @default(uuid())
  externalId  String?
  name        String
  logoUrl     String?
  
  events      Event[]  
  favoritedBy UserFavorite[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// STATS MODELS
// -----------------------------------------------------------------------------
model FootballStats {
  id             String  @id @default(uuid())
  eventId        String  @unique
  event          Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  homeGoals      Int?
  awayGoals      Int?
  homeCards      Int?
  awayCards      Int?
  extraStats     Json?
}

model NbaStats {
  id             String  @id @default(uuid())
  eventId        String  @unique
  event          Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  homePoints     Int?
  awayPoints     Int?
  quarter        Int?
}

model UfcStats {
  id             String  @id @default(uuid())
  eventId        String  @unique
  event          Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  method         String?
  round          Int?
  time           String?
}

model EsportsStats {
  id             String  @id @default(uuid())
  eventId        String  @unique
  event          Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  homeScore      Int?
  awayScore      Int?
  map            String?
}

// -----------------------------------------------------------------------------
// AUDIT & LOGS
// -----------------------------------------------------------------------------
model ScraperLog {
  id         String   @id @default(uuid())
  sport      String
  success    Boolean  @default(true)
  message    String?
  itemsCount Int?     @default(0)
  createdAt  DateTime @default(now())
}

// -----------------------------------------------------------------------------
// USERS & FAVORITES
// -----------------------------------------------------------------------------
model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  name         String?
  
  favorites    UserFavorite[]

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model UserFavorite {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  createdAt     DateTime    @default(now())

  @@unique([userId, participantId]) 
}
